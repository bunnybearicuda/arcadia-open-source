# ─── Required ────────────────────────────────────────────────────────────────

# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# The passcode you type to get in. Make it something you'll remember.
APP_PASSCODE=

# Any long random string. Signs your login cookie so it can't be forged.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Supabase → Project Settings → Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# The SERVICE ROLE key, not the anon key. It never leaves the server.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Optional ────────────────────────────────────────────────────────────────

# Readable backup + your companions' own journal space.
# Without these, journals fall back to a table in Supabase and still work.
NOTION_API_KEY=
NOTION_MEMORY_DATABASE_ID=
NOTION_JOURNAL_PARENT_PAGE_ID=

# Protects /api/cron/* so only Vercel Cron can trigger consolidation.
# Generate the same way as SESSION_SECRET.
CRON_SECRET=
